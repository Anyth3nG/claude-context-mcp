# Embeddings. Required — shared/store.py refuses to fall back to a weaker
# local model silently (see docs/schema.md). Note that a Voyage account with
# no payment method on file is throttled to 3 RPM / 10K TPM regardless of
# tier; adding one lifts voyage-3.5 to 2000 RPM / 8M TPM.
VOYAGE_API_KEY=

# The store's DynamoDB table. This is the backend everywhere that matters —
# deployed, it is required and the function refuses to start without it.
DYNAMODB_TABLE=

# Chroma, LOCAL DEVELOPMENT ONLY. Retired as a backend: not in the deployed
# bundle, not in the secret. What remains is a second implementation for
# shared/conformance.py to run against, which is the whole point of the driver
# seam — a contract proved on one backend proves nothing about the seam. Leave
# these unset for an on-disk store; set ALL THREE for Cloud, or NONE. Setting
# only some raises rather than silently writing to a local database nothing
# else can read.
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_API_KEY=

# Local Chroma store location, used only when the CHROMA_* trio above is unset.
# Leave this unset unless you mean it: a RELATIVE path resolves against the
# process's working directory, so launching the server from a different
# project folder would silently create a second, disconnected store. Unset,
# the path is anchored to the repo (see mcp_server/context.py).
# CHROMA_PATH=

# Bearer token for the deployed HTTP endpoint. Not used in stdio mode.
AUTH_TOKEN=

# Host allowlisted for DNS-rebinding protection — the Lambda Function URL
# domain. Must be the exact hostname: "*" is NOT a wildcard, it is compared
# literally and will reject every request with HTTP 421.
MCP_ALLOWED_HOST=

# Login identity for the Cognito user pool used by the claude.ai connector.
COGNITO_USER_EMAIL=
